{
	"devDependencies": {
		"@wordpress/env": "^10.35.0",
		"@wpelevator/wp-release": "^0.17.0",
		"npm-run-all2": "^8.0.4"
	},
	"scripts": {
		"preinstall": "composer install",
		"release": "wp-release",
		"zip": "wp-release zip --slug minit --force",
		"start": "wp-env start --xdebug",
		"wp-env": "wp-env",
		"cli": "wp-env run cli --env-cwd=wp-content/plugins/minit",
		"test": "npm run cli -- composer test",
		"composer": "npm run cli -- composer",
		"lint": "run-p lint:*",
		"lint:php": "npm run cli -- composer lint",
		"format": "run-p format:*",
		"format:php": "npm run cli -- composer format"
	}
}
